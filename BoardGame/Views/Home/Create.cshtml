@using WebMatrix.Data
@{

    var db = Database.Open("BoardGame");

    var families = db.Query("SELECT DISTINCT * FROM GameFamily ORDER BY Family ASC");
    var themes = db.Query("SELECT DISTINCT * FROM Theme ORDER BY ThemeName ASC");

    var categories = db.Query("SELECT CategoryID, Category FROM Category ORDER BY Category");

    if (IsPost)
    {
        var id = Request["ID"];
        var name = Request.Form["Name"];
        var category = Request.Form["categoryID"];
        var description = Request.Form["Description"];
        var year = Request.Form["YearPublished"];
        var age = Request.Form["ComAgeRec"];
        var minPlayers = Request.Form["MinPlayers"];
        var maxPlayers = Request.Form["MaxPlayers"];
        var img = Request.Form["ImagePath"];
        string family = Request.Form["FamilyCode"];
        var newFamily = Request.Form["newFamily"];
        var themeID = Request.Form["ThemeID"];
        var newTheme = Request.Form["NewTheme"];

        // Add new family
        if (!String.IsNullOrEmpty(newFamily))
        {
            var newFamilyCode = db.QueryValue("SELECT ISNULL(MAX(CAST(SUBSTRING(FamilyCode, 2, LEN(FamilyCode)) AS INT)), 0) + 1 FROM GameFamily");
            db.Execute("INSERT INTO GameFamily (FamilyCode, Family) VALUES (@0, @1)", "F" + newFamilyCode.ToString(), newFamily);
            family = "F" + newFamilyCode.ToString();
        }
        // Before inserting
        var newBGGId = db.QueryValue("SELECT ISNULL(MAX(BGGId), 0) + 1 FROM BoardGame");

        // Insert new game
        var insertSql = @"INSERT INTO BoardGame (BGGId, Name, Description, YearPublished, MinPlayers, MaxPlayers, ImagePath, Family)
                  VALUES (@0, @1, @2, @3, @4, @5, @6, @7)";
        db.Execute(insertSql, newBGGId, name, description, year, minPlayers, maxPlayers, img, family);

        // Category linking
        if (!String.IsNullOrEmpty(category))
        {
            var insertCategory = "INSERT INTO GameCategory (BGGId, Category) VALUES (@0, @1)";
            db.Execute(insertCategory, newBGGId, category);
        }

        // Add new theme 
        if (!String.IsNullOrEmpty(newTheme))
        {
            db.Execute("INSERT INTO Theme (ThemeID, ThemeName) SELECT ISNULL(MAX(CAST(SUBSTRING(ThemeID, 2, LEN(ThemeID)) AS INT)), 0) + 1, @0 FROM Theme", newTheme);
            var newThemeRec = db.QuerySingle("SELECT TOP 1 ThemeID FROM Theme ORDER BY ThemeID DESC");
            themeID = newThemeRec.ThemeID;
        }

        // Link game to selected or new theme
        if (!String.IsNullOrEmpty(themeID))
        {
            db.Execute("INSERT INTO GameInThemes (BGGId, ThemeID) VALUES (@0, @1)", newBGGId, themeID);
        }

        // Successful creation
        Response.Redirect("/Home/Details?id=" + newBGGId);
    }
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add New Game</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        input,
        select,
        textarea {
            max-width: 100% !important;
        }
    </style>
</head>
<body>
    <div class="text-bg-light py-1 mt-2 mb-3">
        <h2 class="text-center mb-4">Add New Game</h2>
        <form method="post" class="container mt-4 p-4 bg-light rounded shadow-sm">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <lable>Name:</lable>
                    <input type="text" name="Name" class="form-control" id="Name" placeholder="Game name" required>
                </div>

            </div>

            <div class="mb-3">
                <label>Description</label>
                <textarea name="Description" id="Description" class="form-control" rows="5" maxlength="5000" placeholder="Game Description"></textarea>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Age Recommendation:</label>
                <input type="number" name="MfgAgeRec" class="form-control"/>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label>Year Published:</label>
                    <input type="number" name="YearPublished" class="form-control"/>
                </div>

                <div class="col-md-4 mb-3">
                    <label>Min Players:</label>
                    <input type="number" name="MinPlayers" class="form-control"/>
                </div>

                <div class="col-md-4 mb-3">
                    <label>Max Players:</label>
                    <input type="number" name="MaxPlayers" class="form-control"/>
                </div>

                <div class="col mb-3">
                    <label class="form-label">Image</label>
                    <input type="url" class="form-control" name="ImagePath" id="Image URL" placeholder="Image URL">
                </div>
            </div>

            <h5>Game Family</h5>
            <div class="form-group">
                <label>Category:</label>
                <select name="Category" class="form-control">
                    <option value=""> Select Category </option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryID">@c.Category</option>
                    }
                </select>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Select Family:</label>
                    <select name="FamilyCode" class="form-control">
                        <option value=""> Select Family </option>
                        @foreach (var f in families)
                        {
                            <option value="@f.FamilyCode">@f.Family</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label>Add New Family:</label>
                    <input type="text" name="NewFamily" class="form-control" placeholder="Enter new family name"/>
                </div>
            </div>

            
            <h5>Game Theme</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Select Theme:</label>
                    <select name="ThemeID" class="form-control">
                        <option value=""> Select Theme </option>
                        @foreach (var t in themes)
                        {
                            <option value="@t.ThemeID">@t.ThemeID</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label>Add New Theme:</label>
                    <input type="text" name="NewTheme" class="form-control" placeholder="Enter new theme name"/>
                </div>
            </div>

            
            <div class="mb-3" style="text-align: right">
                <button type="submit" class="btn btn-success float-right ms-2">Add Game</button>
                <button type="reset" class="btn btn-danger float-right">Reset</button>
            </div>
        </form>
    </div>
</body>
</html>










