@using WebMatrix.Data

@{
    // Get the board game ID
    var gameId = Request.QueryString["id"];

    // Connect to database
    var db = Database.Open("BoardGame");

    // Build SQL query to get game details with category and ratings
    // define the query to be run
    var sql = "SELECT b.*, c.Category AS categoryName, calc.avgRating, calc.reviewCount FROM BoardGame AS b " +
                "LEFT JOIN GameCategory AS gc ON b.BGGId = gc.BGGId " +
                "LEFT JOIN Category AS c ON gc.Category = c.CategoryID " +
                "LEFT JOIN (SELECT BGGId, AVG(Rating) AS avgRating, COUNT(*) AS reviewCount " +
                "FROM UserRating GROUP BY BGGId) AS calc ON b.BGGId = calc.BGGId WHERE b.BGGId LIKE @0";

    // Execute query and get the game data
    var gameData = db.QuerySingle(sql, gameId) ;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Board Game Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <!-- Back button -->
        <a href="/Home/Index" class="back-button">← Back to List</a>

        <!-- Page header -->
        <div class="page-header">
            <h2>Game Details</h2>
        </div>

        @if (gameData != null)
        {
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="game-card card">
                        <div class="card-body">
                            <!-- Game title -->
                            <h1 class="game-title">@gameData.Name</h1>

                            <!-- Game description -->
                            <p class="game-description">@gameData.Description</p>

                            <!-- Rating section -->
                            <div class="rating-section">
                                <h5>
                                    Average Rating: @(gameData.avgRating != null ? Math.Round(Convert.ToDouble(gameData.avgRating), 2).ToString() : "No ratings yet")
                                </h5>
                                <p class="mb-0">
                                    Based on @(gameData.reviewCount ?? 0)
                                    @(gameData.reviewCount == 1 ? "review" : "reviews")
                                </p>
                            </div>

                            <!-- Basic information -->
                            <div class="info-section">
                                <h6>Basic Information</h6>
                                <div class="info-item">
                                    <span class="info-label"><strong>Category:</strong></span>
                                    <span class="info-value">@gameData.categoryName</span>
                                </div>
                                @if (gameData.YearPublished != null)
                                {
                                    <div class="info-item">
                                        <span class="info-label"><strong>Year Published:</strong></span>
                                        <span class="info-value">@gameData.YearPublished</span>
                                    </div>
                                }
                                @if (gameData.Family != null)
                                {
                                    <div class="info-item">
                                        <span class="info-label"><strong>Family:</strong></span>
                                        <span class="info-value">@gameData.Family</span>
                                    </div>
                                }
                            </div>

                            <!-- Player information -->
                            <div class="info-section">
                                <h6>Player Information</h6>
                                <div class="info-item">
                                    <span class="info-label"><strong>Players:</strong></span>
                                    <span class="info-value">@gameData.MinPlayers - @gameData.MaxPlayers players</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label"><strong>Best Player Count:</strong></span>
                                    <span class="info-value">@gameData.BestPlayers</span>
                                </div>
                                @if (gameData.ComAgeRec != null)
                                {
                                    <div class="info-item">
                                        <span class="info-label"><strong>Recommended Age:</strong></span>
                                        <span class="info-value">@Math.Round(Convert.ToDouble(gameData.ComAgeRec), 0)+ years</span>
                                    </div>
                                }
                                <div class="info-item">
                                    <span class="info-label"><strong>Manufacturer Age:</strong></span>
                                    <span class="info-value">@gameData.MfgAgeRec+ years</span>
                                </div>
                            </div>

                            <!-- Game play information -->
                            <div class="info-section">
                                <h6>Game Play</h6>
                                <div class="info-item">
                                    <span class="info-label"><strong>Play Time:</strong></span>
                                    <span class="info-value">@gameData.MfgPlaytime minutes</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label"><strong>Community Play Time:</strong></span>
                                    <span class="info-value">@gameData.ComMinPlaytime - @gameData.ComMaxPlaytime minutes</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label"><strong>Game Weight:</strong></span>
                                    <span class="info-value">@Math.Round(Convert.ToDouble(gameData.GameWeight), 2) / 5.0</span>
                                </div>
                                @if (gameData.LanguageEase != null)
                                {
                                    <div class="info-item">
                                        <span class="info-label"><strong>Language Ease:</strong></span>
                                        <span class="info-value">@Math.Round(Convert.ToDouble(gameData.LanguageEase), 1) / 5.0</span>
                                    </div>
                                }
                            </div>

                            <!-- Popularity statistics -->
                            <div class="info-section">
                                <h6>Popularity</h6>
                                <div class="info-item">
                                    <span class="info-label"><strong>Number Owned:</strong></span>
                                    <span class="info-value">@gameData.NumOwned</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label"><strong>Number Want:</strong></span>
                                    <span class="info-value">@gameData.NumWant</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label"><strong>Number Wish:</strong></span>
                                    <span class="info-value">@gameData.NumWish</span>
                                </div>
                            </div>

                            <!-- Rankings -->
                            <div class="info-section">
                                <h6>Rankings</h6>
                                <div class="info-item">
                                    <span class="info-label"><strong>Game Rank:</strong></span>
                                    <span class="info-value">@gameData.RankInboardgame</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label"><strong>Strategy Games Rank:</strong></span>
                                    <span class="info-value">@gameData.RankInstrategygames</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label"><strong>Family Games Rank:</strong></span>
                                    <span class="info-value">@gameData.RankInfamilygames</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label"><strong>Thematic Rank:</strong></span>
                                    <span class="info-value">@gameData.RankInthematic</span>
                                </div>
                            </div>

                            <!-- Related games -->
                            <div class="info-section">
                                <h6>Related Games</h6>
                                <div class="info-item">
                                    <span class="info-label"><strong>Alternates:</strong></span>
                                    <span class="info-value">@gameData.NumAlternates</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label"><strong>Expansions:</strong></span>
                                    <span class="info-value">@gameData.NumExpansions</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label"><strong>Implementations:</strong></span>
                                    <span class="info-value">@gameData.NumImplementations</span>
                                </div>
                            </div>

                            <!-- Game image -->
                            <img class="game-image" src="@gameData.ImagePath" alt="@gameData.Name" style="width: 1000px;">
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="error-message">
                <h2>Oopps! That game is not available.</h2>
                <p>The game doesn't exist.</p>
                <a href="/Home/Index" class="back-button">Return to List</a>
            </div>
        }
    </div>
</body>
</html>