@using WebMatrix.Data
@{
    // Database connection
    var db = Database.Open("BoardGame");

    // Get search and category filters from query string
    var search = Request["search"];
    var category = Request["category"];
    var viewMode = Request["viewMode"] ?? "table";

    // Base SQL query
    var sql = @"
    SELECT 
        bg.BGGId,
        bg.Name,
        bg.Description,
        bg.YearPublished,
        bg.MinPlayers,
        bg.MaxPlayers,
        bg.MfgPlayTime AS PlayTime,
        bg.Family,
        bg.ImagePath,
        c.Category
    FROM BoardGame AS bg
    JOIN GameCategory AS gc ON bg.BGGId = gc.BGGId
    JOIN Category AS c ON c.CategoryID = gc.Category
    JOIN GameFamily AS f ON f.FamilyCode = bg.Family";

    var parameters = new List<object>();
    var whereClauses = new List<string>();

    // Add conditions
    if (!String.IsNullOrEmpty(search))
    {
        whereClauses.Add("bg.Name LIKE @" + parameters.Count);
        parameters.Add("%" + search + "%");
    }

    // Filter for categories
    if (!String.IsNullOrEmpty(category) && category != "All")
    {
        whereClauses.Add("c.Category = @" + parameters.Count);
        parameters.Add(category);
    }

    if (whereClauses.Count > 0)
    {
        sql += " WHERE " + String.Join(" AND ", whereClauses);
    }

    sql += " ORDER BY bg.Name";

    // Run query
    var games = db.Query(sql, parameters.ToArray());
}

<!DOCTYPE html>
<html>
<head>
    <title>Board Games</title>
    <style></style>
</head>
<body>
    <h1>Board Games</h1>

    <form method="get" class="row g-3 mb-4 align-items-end">
        <!-- Search box -->
        <div class="col-md-4">
            <input type="text" name="search" value="@Request["search"]" placeholder="Search by name..." />
            @*<input type="submit" value="Search" />*@
        </div>

        <div class="col-md-3">
            <label for="category" class="form-lable">Category</label>
            <select id="category" name="category" class="form-select">
                <option value="All">All Categories</option>
                @*@foreach (var c in categories)*@
                {
                    @*<option value="@c.Category" @(category == c.Category ? "selected" : "")>@c.Category</option>*@
                }
            </select>
        </div>

        <!--View mode-->
        <div class="col-md-3">
            <label class="form-lable">View Mode</label>
            <div>
                <input type="radio" id="viewTable" name="viewMode" value="table" @(viewMode == "table" ? "checked" : "")>
                <lable for="viewTable" class="me-2">Table</lable>
                <input type="radio" id="viewCard" name="viewMode" value="card" @(viewMode=="card"?"checked":"")>
                <label for="viewCard">Card</label>
            </div>
        </div>

        <!--search button-->
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </form>

    @*<button onclick="toggleView()">Toggle View</button>*@
    <div id="tableView" class="active-view">
        <h2>Table View</h2>
    </div>

    <table border="1" cellpadding="5" class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Year Published</th>
                <th>Description</th>
            </tr>
        </thead>
            @foreach (var game in games)
            {
                <tr>
                    <td>@game.Name</td>
                    <td>@game.Category</td>
                    <td>@game.YearPublished</td>
                    <td>@game.Description</td>
                </tr>
            }
    </table>
</body>
</html>