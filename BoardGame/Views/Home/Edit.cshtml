@using WebMatrix.Data
@{
    var db = Database.Open("BoardGame");

    var id = Request.QueryString["id"];
    var message = "";
    var messageType = "";
    if (IsPost)
    {
        try
        {
            var name = Request.Form["Name"];
            var year = Request.Form["YearPublished"];
            var minPlayers = Request.Form["MinPlayers"];
            var maxPlayers = Request.Form["MaxPlayers"];
            var img = Request.Form["ImagePath"];
            var family = Request.Form["Family"];
            var description = Request.Form["Description"];
            var mfgPlayTime = Request.Form["MfgPlayTime"];
            var mfgAgeRec = Request.Form["MfgAgeRec"];
            var age = Request.Form["ComAgeRec"];
            var gameWeight = Request.Form["GameWeight"];
            var languageEase = Request.Form["LanguageEase"];
            var bestPlayers = Request.Form["BestPlayers"];
            string numOwned = Request.Form["NumOwned"];
            string numWant = Request.Form["NumWant"];
            string numWish = Request.Form["NumWish"];
            var comMinPlayTime = Request.Form["ComMinPlayTime"];
            var comMaxPlayTime = Request.Form["comMaxPlayTime"];
            var rankInBoardGame = Request.Form["rankInBoardGame"];
            var rankinStrategyGames = Request.Form["rankinStrategyGames"];
            var rankInFamilyGames = Request.Form["rankInFamilyGames"];
            var rankinThematic = Request.Form["rankinThematic"];
            var numAlternates = Request.Form["numAlternates"];
            var numExpansions = Request.Form["numExpansions"];
            var numImplementations = Request.Form["numImplementations"];

            // Update the game
            var updateQuery = @"UPDATE BoardGame SET
                Name = @1, YearPublished = @2, MinPlayers = @3, MaxPlayers = @4,
                ImagePath = @5, Family = @6, Description = @7, MfgPlayTime = @8,
                MfgAgeRec = @9, ComAgeRec = @10, GameWeight = @11, LanguageEase = @12,
                BestPlayers = @13, NumOwned = @14, NumWant = @15, NumWish = @16,
                ComMinPlaytime = @17, ComMaxPlaytime = @18, RankInboardgame = @19,
                RankInstrategygames = @20, RankInfamilygames = @21, RankInthematic = @22,
                NumAlternates = @23, NumExpansions = @24, NumImplementations = @25
                WHERE BGGId = @0";

            var rowsAffected = db.Execute(updateQuery, id, name, year, minPlayers, maxPlayers,
                img, family, description, mfgPlayTime, mfgAgeRec, age, gameWeight, languageEase,
                bestPlayers, numOwned, numWant, numWish, comMinPlayTime, comMaxPlayTime, rankInBoardGame,
                rankinStrategyGames, rankInFamilyGames, rankinThematic,
                numAlternates, numExpansions, numImplementations);

            if (rowsAffected > 0)
            {
                message = "Record updated successfully!";
                messageType = "success";
            }
            else
            {
                message = "No record was updated!";
                messageType = "warning";
            }
        }
        catch (Exception Exception)
        {
            message = "Failed to update: " + Exception.Message;
            messageType = "danger";
        }
    }

    // game details
    dynamic game = null;
    if (!String.IsNullOrEmpty(id))
    {
        game = db.QuerySingle("SELECT * FROM BoardGame WHERE BGGId = @0", id);
    }
    var families = db.Query("SELECT DISTINCT * FROM GameFamily ORDER BY Family ASC");
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Game</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        input,
        select,
        textarea {
            max-width: 100% !important;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="card text-bg-light py-1 mt-2 mb-3">
            <h2 class="text-center">Edit Game</h2>
        </div>

        @if (!String.IsNullOrEmpty(message))
        {
            <div class="alert alert-@messageType text-center">@message</div>
        }

        @if (game == null)
        {
            <div class="alert alert-danger text-center">
                <h5>Game not found!</h5>
            </div>
        }
        else
        {
    <form method="post" class="p-4 bg-light rounded shadow-sm">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Game ID:</label>
                <input type="text" class="form-control" value="@game.BGGId" disabled>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Name:</label>
                <input type="text" name="Name" class="form-control" value="@game.Name" required>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Description:</label>
            <textarea name="Description" class="form-control" rows="5" maxlength="5000">@game.Description</textarea>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Year Published:</label>
                <input type="number" name="Year" class="form-control" value="@game.YearPublished">
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Min Players:</label>
                <input type="number" name="MinPlayers" class="form-control" value="@game.MinPlayers">
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Max Players:</label>
                <input type="number" name="MaxPlayers" class="form-control" value="@game.MaxPlayers">
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Play Time:</label>
                <input type="number" name="MfgPlayTime" class="form-control" value="@game.MfgPlayTime">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Age Recommendation:</label>
                <input type="number" name="MfgAgeRec" class="form-control" value="@game.MfgAgeRec">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Community Age Recommendation:</label>
                <input type="number" name="ComAgeRec" class="form-control" value="@game.ComAgeRec">
            </div>

        </div>

        <div class="mb-3">
            <label class="form-label">Image URL:</label>
            <input type="url" name="ImagePath" class="form-control" value="@game.ImagePath">
        </div>

        <div class="mb-3">
            <label class="form-label">Family:</label>
            <select name="Family" class="form-control">
                <option value="">Select Family</option>
                @foreach (var f in families)
                {
                    <option value="@f.FamilyCode" @(f.FamilyCode == game.Family ? "selected" : "")>@f.Family</option>
                }
            </select>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Game Weight:</label>
            <input type="number" name="GameWeight" class="form-control" value="@game.GameWeight">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Language Ease:</label>
            <input type="number" name="LanguageEase" class="form-control" value="@game.LanguageEase">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Best Players:</label>
            <input type="number" name="BestPlayers" class="form-control" value="@game.BestPlayers">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Num Owned:</label>
            <input type="number" name="NumOwned" class="form-control" value="@game.NumOwned">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">NumWant:</label>
            <input type="number" name="NumWant" class="form-control" value="@game.NumWant">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">ComMin PlayTime:</label>
            <input type="number" name="ComMinPlayTime" class="form-control" value="@game.ComMinPlayTime">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">comMax PlayTime:</label>
            <input type="number" name="comMaxPlayTime" class="form-control" value="@game.comMaxPlayTime">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">rank In BoardGame:</label>
            <input type="number" name="rankInBoardGame" class="form-control" value="@game.rankInBoardGame">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">rank in Strategy Games:</label>
            <input type="number" name="rankinStrategyGames" class="form-control" value="@game.rankinStrategyGames">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">rank In Family Games:</label>
            <input type="number" name="rankInFamilyGames" class="form-control" value="@game.rankInFamilyGames">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">rank in Thematic:</label>
            <input type="number" name="rankinThematic" class="form-control" value="@game.rankinThematic">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">num Alternates:</label>
            <input type="number" name="numAlternates" class="form-control" value="@game.numAlternates">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">num Expansions:</label>
            <input type="number" name="numExpansions" class="form-control" value="@game.numExpansions">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">num Implementations:</label>
            <input type="number" name="numImplementations" class="form-control" value="@game.numImplementations">
        </div>

        <hr />
        <div class="mb-3" style="text-align: right">
            <a href="/Home/Details?id=@game.BGGId" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-success ms-2">Update Game</button>
        </div>
    </form>
        }
    </div>
</body>
</html>